{
  "expo": {
    "name": "Clipzo",
    "slug": "clipzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/CLIPZO Logo 2.png",
    "scheme": "clipzo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/CLIPZO Logo 2.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.videogen.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/CLIPZO Logo 2.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 22,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/CLIPZO Logo 2.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-video",
      "react-native-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c9ef8df-d5b9-4518-a863-337d7e1d21f2"
      }
    }
  }
}
